rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // A live session. Only the DM who made it can change or end it.
    match /sessions/{code} {
      function isDM() {
        return signedIn() && get(/databases/$(database)/documents/sessions/$(code)).data.dmUid == request.auth.uid;
      }
      function isMember() {
        return signedIn() && exists(/databases/$(database)/documents/sessions/$(code)/players/$(request.auth.uid));
      }
      function isRipper() {
        return 'TEC.B.l' in get(/databases/$(database)/documents/sessions/$(code)/players/$(request.auth.uid)).data.merc.unlocked;
      }
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.dmUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.dmUid == request.auth.uid;

      // Portraits. Each player sets their own (small JPEGs only). Everyone in the session can see them.
      match /portraits/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.img is string && request.resource.data.img.size() < 300000;
        allow delete: if signedIn() && (request.auth.uid == uid || isDM());
      }

      // NPC ID cards. Everyone in the session can see them, only the DM writes.
      // These only hold the name, origin, portrait and a critical/flatlined flag. HP stays private.
      match /npcs/{id} {
        allow read: if signedIn();
        allow write: if isDM();
      }

      // Handouts. Maps and images the DM shows to the party. Everyone in the session can see them.
      match /handouts/{id} {
        allow read: if signedIn();
        allow create, update: if isDM() && request.resource.data.img is string && request.resource.data.img.size() < 1000000;
        allow delete: if isDM();
      }

      // Change log. Players add entries about their own merc, the DM can add or clear them.
      match /log/{id} {
        allow read: if signedIn();
        allow create: if (isDM() || (isMember() && request.resource.data.uid == request.auth.uid))
          && request.resource.data.lines is list && request.resource.data.lines.size() <= 20;
        allow delete: if isDM();
      }

      // Each player writes only their own merc. The DM can remove players.
      match /players/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.auth.uid == uid
          && exists(/databases/$(database)/documents/sessions/$(code));
        allow delete: if signedIn() && (request.auth.uid == uid || isDM());

        // The DM can send anything. Players can hand over items and eddies,
        // and only a RipperDoc can install or remove someone's cyberware.
        match /inbox/{op} {
          allow create: if isDM() || (isMember() && request.resource.data.from == request.auth.uid && (
            request.resource.data.kind == 'item' ||
            (request.resource.data.kind == 'eddies' && request.resource.data.amount > 0) ||
            ((request.resource.data.kind == 'install' || request.resource.data.kind == 'uninstall') && isRipper())
          ));
          allow read, delete: if signedIn() && (request.auth.uid == uid || isDM());
        }
      }
    }

    // Each DM's item library. Players can read it so their Codex stays in sync. Only the DM writes.
    match /dms/{uid}/library/{item} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Each DM's private NPC stats (HP, advantage, notes). DM only.
    match /dms/{uid}/npcs/{id} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Each DM's party backups and session notes. DM only.
    match /dms/{uid}/party/{id} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    match /dms/{uid}/notes/{code} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Cloud saves. Each account reads and writes only its own mercs, portraits and session lists.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      match /{rest=**} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }
  }
}
